# Шаблон переменных окружения. Скопируй в .env и заполни. .env в .gitignore — секреты не коммитятся.

# --- Яндекс Метрика (для SEO-агентов: чтение статистики через API) ---
# Счётчик уже вшит в сайт (Base.astro / site.js). Токен нужен ТОЛЬКО для чтения данных агентами.
YANDEX_METRICA_COUNTER=53352265
# OAuth-токен. Как получить: см. ниже "Как выпустить токен".
YANDEX_METRICA_TOKEN=

# --- Яндекс Вебмастер (опционально: запросы, показы, индексация через API) ---
# Тот же OAuth-токен можно выпустить с правами и на Вебмастер (добавить его scope при создании приложения).
YANDEX_WEBMASTER_TOKEN=
YANDEX_WEBMASTER_USER_ID=
YANDEX_WEBMASTER_HOST_ID=

# === Как выпустить токен (делается один раз, в браузере под ВАШИМ аккаунтом) ===
# 1. oauth.yandex.ru -> "Создать приложение".
# 2. Платформа: "Веб-сервисы". Redirect URI: https://oauth.yandex.ru/verification_code
# 3. Доступы -> добавить "Яндекс Метрика" (получение статистики). При желании — "Яндекс Вебмастер".
# 4. Создать -> скопировать ClientID.
# 5. Открыть в браузере (подставив ClientID):
#    https://oauth.yandex.ru/authorize?response_type=token&client_id=ВАШ_CLIENT_ID
# 6. Подтвердить -> Яндекс покажет access_token в адресной строке (после #access_token=...).
# 7. Вставить его в YANDEX_METRICA_TOKEN выше.
