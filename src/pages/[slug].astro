---
import Base from '../layouts/Base.astro';
import { pages } from '../data/pages.js';
import { site, slashed, tgHref } from '../data/site.js';
import { tiers, priceTable, terms, PRICE_URL } from '../data/prices.js';

export function getStaticPaths() {
  return Object.entries(pages).map(([slug, data]) => ({
    params: { slug },
    props: { data },
  }));
}

const { data } = Astro.props;
const slug = Astro.params.slug;                    // он же уезжает боту в /start
const path = '/' + slug;                           // без слэша — для матчинга nav
// slashed() импортирован из site.js — один канонизатор путей на весь сайт

// Хлебные крошки: Главная → (родитель из nav) → текущая.
// Матчинг родителя — по бесслэшевому href (как в site.nav), а URL в разметке — со слэшем.
const parent = site.nav.find((item) => item.children?.some((c) => c.href === path));
const breadcrumbs = [{ name: 'Главная', url: '/' }];
if (parent) breadcrumbs.push({ name: parent.label, url: slashed(parent.href) });
breadcrumbs.push({ name: data.h1, url: slashed(path) });

// Цены. Если слаг совпал с материалом из прайса — страница получает таблицу тарифа
// автоматически. Цифры живут ТОЛЬКО в src/data/prices.js: правишь их там —
// меняется и /ceny-na-frezerovky/, и этот блок на всех страницах материалов сразу.
const priceBlock = priceTable.find((m) => m.href === path) || null;
const priceMin = priceBlock
  ? Math.min(...priceBlock.rows.map((r) => Math.min(...r.v)))
  : null;

// Service-схема услуги
const serviceSchema = {
  '@type': 'Service',
  name: data.h1,
  serviceType: data.h1,
  provider: { '@id': site.url + '/#org' },
  areaServed: { '@type': 'Country', name: 'Россия' },
  url: new URL(slashed(path), site.url).href,
  description: data.description,
  ...(priceBlock && {
    offers: {
      '@type': 'Offer',
      priceCurrency: 'RUB',
      price: priceMin,
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        priceCurrency: 'RUB',
        price: priceMin,
        unitText: 'погонный метр реза',
      },
      url: new URL(PRICE_URL, site.url).href,
    },
  }),
};

// FAQPage-схема (если у страницы есть блок вопросов) — расширенные сниппеты + AI-поиск
const faqSchema = data.faq?.length
  ? {
      '@type': 'FAQPage',
      mainEntity: data.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;

const pageSchema = faqSchema ? [serviceSchema, faqSchema] : [serviceSchema];
---

<Base title={data.title} description={data.description} breadcrumbs={breadcrumbs} schema={pageSchema}>
  <article class="section">
    <div class="container">
      <div class="page-head">
        <h1>{data.h1}</h1>
        {data.lead && <p class="lead page-lead">{data.lead}</p>}
        {data.todo && <span class="badge todo-badge">черновик — обогащается</span>}
      </div>

      {data.heroGallery?.length && (
        <div class="hero-gallery">
          {data.heroGallery.map((g, idx) => (
            <figure class={`hg-shot${idx === 0 ? ' hg-feature' : ''}`}>
              <picture>
                <source srcset={g.webp} type="image/webp" />
                <img src={g.jpg} alt={g.alt} loading={idx < 3 ? 'eager' : 'lazy'} decoding="async" />
              </picture>
            </figure>
          ))}
        </div>
      )}

      <div class="prose">
        {data.blocks?.map((block) => {
          if (block.type === 'h2') return <h2>{block.text}</h2>;
          if (block.type === 'h3') return <h3>{block.text}</h3>;
          if (block.type === 'ul') return <ul>{block.items.map((i) => <li>{i}</li>)}</ul>;
          if (block.type === 'links') return <ul class="link-list">{block.items.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>;
          if (block.type === 'figure') return (
            <figure class={`prose-fig${block.wide ? ' prose-fig-wide' : ''}`}>
              <picture>
                <source srcset={block.webp} type="image/webp" />
                <img src={block.jpg} alt={block.alt} loading="lazy" decoding="async" />
              </picture>
              {block.caption && <figcaption>{block.caption}</figcaption>}
            </figure>
          );
          if (block.type === 'figpair') return (
            <div class="prose-figpair">
              {block.items.map((g) => (
                <figure>
                  <picture>
                    <source srcset={g.webp} type="image/webp" />
                    <img src={g.jpg} alt={g.alt} loading="lazy" decoding="async" />
                  </picture>
                </figure>
              ))}
            </div>
          );
          if (block.type === 'gallery') return (
            <div class="work-gallery">
              {block.items.map((g) => (
                <figure class="work-shot">
                  <picture>
                    <source srcset={g.webp} type="image/webp" />
                    <img src={g.jpg} alt={g.alt} loading="lazy" />
                  </picture>
                  {g.caption && <figcaption>{g.caption}</figcaption>}
                </figure>
              ))}
            </div>
          );
          return <p>{block.text}</p>;
        })}
      </div>

      {priceBlock && (
        <section class="price-sec" id="ceny">
          <h2>Сколько стоит</h2>
          <p class="price-sub">
            Считаем по погонному метру реза: складываем длины всех контуров и умножаем на тариф.
            Материал в цену не входит, минимальный заказ — {terms.minOrder.toLocaleString('ru-RU')} ₽.
          </p>

          <div class="price-scroll">
            <table class="ptab">
              <thead>
                <tr>
                  <th scope="col" class="ptab-th">Толщина, мм</th>
                  {tiers.map((t) => <th scope="col">{t.short}</th>)}
                </tr>
              </thead>
              <tbody>
                {priceBlock.rows.map((r) => (
                  <tr>
                    <th scope="row" class="ptab-th">{r.t}</th>
                    {r.v.map((p, i) => (
                      <td class={i === 0 ? 'ptab-base' : ''}>{p}<span class="ptab-cur"> ₽</span></td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="price-legend">
            Столбцы — метраж реза в одном заказе: {tiers.map((t) => t.full).join(' · ')}.
            Срочно — надбавка от {terms.urgency}%, сложный контур — от {terms.complexity}%.
          </p>
          <a href={PRICE_URL} class="price-all">Весь прайс и условия →</a>
        </section>
      )}

      {data.faq?.length && (
        <section class="faq">
          <h2>Частые вопросы</h2>
          <div class="faq-list">
            {data.faq.map((f) => (
              <details class="faq-item">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <div class="page-cta card card-featured">
        <h3>Обсудить заказ</h3>
        <p>Пришлите чертёж или опишите задачу — рассчитаем и подскажем по материалу.</p>
        <div class="page-cta-actions">
          <a href={tgHref(slug)} class="btn btn-primary" target="_blank" rel="noopener">Написать в Telegram</a>
          {site.contacts.maxHref && <a href={site.contacts.maxHref} class="btn btn-secondary" target="_blank" rel="noopener">Написать в MAX</a>}
          <a href="tel:+79255560166" class="btn btn-secondary">+7 925 556-01-66</a>
        </div>
      </div>
    </div>
  </article>
</Base>

<style>
  .page-head { margin-bottom: var(--space-8); }
  .page-lead { margin-top: var(--space-4); max-width: 70ch; }

  /* ─── Ценовой блок (только у страниц материалов из prices.js) ─────────── */
  .price-sec { margin: var(--space-16) 0; scroll-margin-top: 88px; }
  .price-sec h2 { margin-bottom: var(--space-3); }
  .price-sub { color: var(--text-secondary); max-width: 70ch; margin-bottom: var(--space-6); }
  .price-scroll {
    overflow-x: auto;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
    -webkit-overflow-scrolling: touch;
  }
  .ptab {
    width: 100%; min-width: 480px;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .ptab th, .ptab td {
    padding: var(--space-3) var(--space-4);
    text-align: right;
    border-bottom: 1px solid var(--border-subtle);
  }
  .ptab thead th {
    font-family: var(--font-mono); font-size: 12px; font-weight: 600;
    text-transform: uppercase; letter-spacing: .06em;
    color: var(--text-tertiary); background: var(--bg-tertiary);
    white-space: nowrap;
  }
  .ptab tbody tr:last-child th, .ptab tbody tr:last-child td { border-bottom: 0; }
  .ptab tbody tr:hover th, .ptab tbody tr:hover td { background: var(--bg-tertiary); }
  .ptab-th {
    text-align: left !important; font-weight: 600;
    color: var(--text-primary); white-space: nowrap;
  }
  .ptab tbody td {
    font-family: var(--font-mono); font-size: 15px; color: var(--text-secondary);
  }
  .ptab tbody td.ptab-base { color: var(--text-primary); font-weight: 600; }
  .ptab-cur { color: var(--text-tertiary); font-size: 12px; }
  .price-legend {
    font-size: 13px; color: var(--text-tertiary);
    margin: var(--space-3) 0 var(--space-4); max-width: 70ch;
  }
  .price-all {
    display: inline-block; font-weight: 600; color: var(--accent-primary);
    transition: color var(--duration-fast) var(--ease-default);
  }
  .price-all:hover { color: var(--accent-hover); }

  /* Hero-мозаика работ: крупный «фичер» + асимметричные плитки, editorial-стиль */
  .hero-gallery {
    margin: 0 0 var(--space-16);
    display: grid;
    gap: var(--space-2);
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 42vw;
  }
  .hg-shot {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    background: var(--bg-secondary);
  }
  .hg-shot img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    transition: transform var(--duration-slow, 600ms) var(--ease-out, ease);
  }
  .hg-shot:hover img { transform: scale(1.045); }
  /* mobile: фичер на всю ширину сверху, ниже блок 2×2 из четырёх малых */
  .hg-feature { grid-column: span 2; }

  @media (min-width: 720px) {
    /* 4 колонки × 2 ряда: фичер 2×2 слева, блок 2×2 из четырёх малых справа */
    .hero-gallery { grid-template-columns: repeat(4, 1fr); grid-auto-rows: 190px; gap: var(--space-3); }
    .hg-feature { grid-column: span 2; grid-row: span 2; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hg-shot img { transition: none; }
    .hg-shot:hover img { transform: none; }
  }

  /* Фото, разнесённые по тексту (figure / пара) */
  .prose-fig { margin: var(--space-10) 0; }
  .prose-fig img {
    width: 100%; display: block;
    aspect-ratio: 3 / 2; object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
  }
  .prose-fig-wide img { aspect-ratio: 16 / 9; }
  .prose-fig figcaption { margin-top: var(--space-2); font-size: 13px; color: var(--text-tertiary); }

  .prose-figpair {
    margin: var(--space-10) 0;
    display: grid; grid-template-columns: 1fr; gap: var(--space-3);
  }
  .prose-figpair figure { margin: 0; }
  .prose-figpair img {
    width: 100%; display: block;
    aspect-ratio: 3 / 2; object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
  }
  @media (min-width: 640px) { .prose-figpair { grid-template-columns: 1fr 1fr; } }
  .todo-badge { margin-top: var(--space-4); background: var(--accent-subtle); color: var(--warning); }
  .page-cta { margin-top: var(--space-16); max-width: 720px; }
  .page-cta h3 { margin-bottom: var(--space-2); }
  .page-cta-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }

  /* Галерея работ */
  .work-gallery {
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-4);
  }
  .work-shot { margin: 0; }
  .work-shot img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    display: block;
  }
  .work-shot figcaption {
    margin-top: var(--space-2);
    font-size: 13px;
    color: var(--text-tertiary);
  }

  /* FAQ */
  .faq { margin-top: var(--space-16); max-width: 760px; }
  .faq > h2 { margin-bottom: var(--space-6); }
  .faq-list { display: flex; flex-direction: column; gap: var(--space-2); }
  .faq-item {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
    padding: var(--space-4) var(--space-6);
  }
  .faq-item summary {
    cursor: pointer; font-weight: 600; list-style: none;
    display: flex; justify-content: space-between; align-items: center; gap: var(--space-4);
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; color: var(--accent-primary); font-size: 1.4em; line-height: 1; }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item p { margin-top: var(--space-3); color: var(--text-secondary); }
</style>
