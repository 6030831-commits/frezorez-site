---
import Base from '../layouts/Base.astro';
import { site, tgHref } from '../data/site.js';
const { contacts, materials } = site;

// ─── Логотипы клиентов ────────────────────────────────────────────────────────
// Логотипы нормализованы: белый фон, впечённые поля обрезаны, единый отступ 6%
// (оригиналы — в _backup-originals/partners-orig/). Список живёт в site.js —
// он общий с /o-nas/, дублировать его здесь нельзя (так и разъехались расширения).
const partnerLogos = site.clientLogos;

// ─── Направления (хаб → /frezerovka-chpy) ────────────────────────────────────
const directions = [
  {
    eyebrow: 'Листовые неметаллы',
    title: 'Фрезеровка ЧПУ',
    text: 'Фанера, дерево, МДФ, ЛДСП, акрил, ПВХ, АКП. Рабочее поле 2.2×4.2 м, точность 0.025 мм.',
    href: '/frezerovka-chpy/',
    img: '/images/covers/frezerovka-cover.jpg',
  },
  {
    eyebrow: 'CO2 · неметаллы',
    title: 'Лазерная резка',
    text: 'Резка и гравировка фанеры, оргстекла, кожи, резины. Поле 1300×900 мм, стол до 600 мм.',
    href: '/lazernaja-rezka/',
    img: '/images/covers/lazer-cover.jpg',
  },
  {
    eyebrow: 'Рельеф · декор',
    title: '3D-фрезеровка',
    text: 'Панно, резной декор для классических интерьеров, эмблемы. Точность до 0.25 мм.',
    href: '/3d-frezerovka/',
    img: '/images/covers/3d-card.jpg',
  },
];

// ─── Примеры работ (факты из CONTENT.md, без выдуманных метрик) ───────────────
const cases = [
  {
    eyebrow: 'Фанера · Серийный заказ',
    title: 'Аксессуары для баров и ресторанов',
    text: 'Доски для подачи, обложки меню, коробочки для чеков, таблички RESERVED — серийно, с лазерной гравировкой логотипа. Покрытие только натуральными маслами и пчелиным воском.',
    tags: ['Фанера', 'ЧПУ + Лазер', 'HoReCa'],
    img: '/images/covers/posuda-cover.jpg',
    href: '/izgotovlenie-produkcii-iz-horeca/',
  },
  {
    eyebrow: 'МДФ · Интерьер ресторана',
    title: 'Ажурные панели для ресторана',
    text: 'Комплект резных панелей для зала ресторана узбекской кухни: фрезеровка орнамента на МДФ, покраска и монтаж по месту. Ажур задаёт восточный характер интерьера.',
    tags: ['МДФ', 'Фрезеровка', 'Интерьер'],
    img: '/images/covers/reznye-cover.jpg',
    href: '/frezerovka-dereva/',
  },
  {
    eyebrow: 'Фанера · Для детей',
    title: 'Игровой комплекс для детского сада',
    text: 'Двухъярусный игровой комплекс из берёзовой фанеры: платформа-чердак, лестница, декоративные окна-иллюминаторы. Все кромки скруглены и отшлифованы — безопасно для детей.',
    tags: ['Фанера', 'Мебель', 'Дети'],
    img: '/images/covers/igrovoy-cover.jpg',
    href: '/mebel-iz-fanery/',
  },
  {
    eyebrow: 'Фанера · Упаковка',
    title: 'Деревянные коробки под подарочные наборы',
    text: 'Партия коробок и лотков из фанеры под подарочную упаковку и наборы: аккуратная реечная сборка, чистая кромка, штабелируются. Готовы под брендирование гравировкой.',
    tags: ['Фанера', 'Упаковка', 'Серия'],
    img: '/images/covers/korobki-cover.jpg',
    href: '/korobochki-penaly-iz-dereva/',
  },
  {
    eyebrow: 'Дерево · Интерьер',
    title: 'Кашпо с реечным экраном для озеленения',
    text: 'Деревянное кашпо для озеленения интерьера: верхний короб под растения и декоративная реечная решётка, закрывающая радиатор. Массив с брашировкой и защитным покрытием.',
    tags: ['Дерево', 'Кашпо', 'Интерьер'],
    img: '/images/covers/yaschiki-cover.jpg',
    href: '/yaschiki-podiumy-kashpo/',
  },
  {
    eyebrow: 'Дерево · Индивидуальный заказ',
    title: 'Резной декор по мотивам старинной мебели',
    text: 'Скопировали элемент декора антикварного шкафа: сняли размеры с оригинала, построили 3D-модель в Rhino 3D, изготовили деталь в точности. Материал — ясень, отделка шёлковым маслом с тонировкой.',
    tags: ['Дерево', '3D-фрезеровка', 'Реставрация'],
    img: '/images/3d/2.jpg',
    href: '/3d-frezerovka/',
  },
];

// ─── Процесс работы ───────────────────────────────────────────────────────────
const steps = [
  {
    num: '01',
    title: 'Присылаете файл или идею',
    text: 'CDR, PDF, DWG, DXF, STL — или просто фото и описание задачи.',
  },
  {
    num: '02',
    title: 'Рассчитываем стоимость',
    text: 'Подбираем материал и технологию, считаем смету. Консультируем по конструктиву.',
  },
  {
    num: '03',
    title: 'Изготавливаем в Москве',
    text: 'Фрезеруем, режем лазером, красим, собираем — всё на своём производстве.',
  },
  {
    num: '04',
    title: 'Доставляем или самовывоз',
    text: 'GettDelivery, Dostavista, Грузовичкоф или самовывоз с ул. Буракова, 6.',
  },
];
---

<Base
  title="FREZOREZ — фрезеровка на ЧПУ, лазерная резка и 3D в Москве"
  description="Столярное производство в Москве с 2016 года: ЧПУ-фрезеровка, лазерная резка, 3D-фрезеровка и сборка по вашим чертежам. Фрезеруем все материалы, кроме железа. Расчёт бесплатно."
>

  <!-- ① HERO ─────────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-content">
        <span class="badge badge-accent badge-mono hero-badge">Столярное производство · Москва · с 2016</span>
        <h1 class="hero-h1">Воплощаем идеи<br><span class="accent-text">в дереве и металле</span></h1>
        <p class="lead hero-lead">
          ЧПУ-фрезеровка, лазерная резка, 3D и сборка по вашим чертежам.
          Фрезеруем любые материалы, кроме железа — железо режем лазером.
        </p>
        <div class="hero-actions">
          <a href={tgHref()} class="btn btn-primary btn-lg" target="_blank" rel="noopener">Написать в Telegram</a>
          {contacts.maxHref && <a href={contacts.maxHref} class="btn btn-secondary btn-lg" target="_blank" rel="noopener">Написать в MAX</a>}
          <a href={contacts.phoneHref} class="btn btn-ghost btn-lg">{contacts.phone}</a>
          <a href={contacts.emailHref} class="btn btn-primary btn-lg">{contacts.email}</a>
        </div>
        <p class="hero-mail">Пришлите чертёж на почту — рассчитаем стоимость и сроки.</p>
      </div>
      <div class="hero-visual">
        <img src="/images/works/frezerovka/fedor-01.jpg" alt="Фрезеровка на ЧПУ в цехе FREZOREZ, Москва" loading="eager" />
      </div>
    </div>
  </section>

  <!-- ② КЛИЕНТЫ ──────────────────────────────────────────────────────────── -->
  <section class="section clients-section">
    <div class="container">
      <div class="logos-row">
        {partnerLogos.map((p) => (
          <div class="logo-item" title={p.name}>
            <img src={p.src} alt={p.name} loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ③ НАПРАВЛЕНИЯ ──────────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Что делаем</div>
        <h2>Три направления производства</h2>
      </div>
      <div class="grid grid-3">
        {directions.map((d) => (
          <a href={d.href} class="card card-link dir-card">
            <div class="dir-photo">
              <img src={d.img} alt={d.title} loading="lazy" />
            </div>
            <div class="dir-body">
              <div class="eyebrow">{d.eyebrow}</div>
              <h3 class="dir-title">{d.title}</h3>
              <p>{d.text}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="hub-row">
        <a href="/frezerovka-chpy/" class="hub-link">
          Все материалы и подвиды фрезеровки <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ④ ПРИМЕРЫ РАБОТ ────────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Примеры работ</div>
        <h2>Реализованные проекты</h2>
      </div>
      <div class="grid grid-3 projects">
        {cases.map((c) => (
          <a href={c.href} class="card card-link project-card">
            <div class="project-photo">
              <img src={c.img} alt={c.title} loading="lazy" decoding="async" />
            </div>
            <div class="project-body">
              <div class="eyebrow">{c.eyebrow}</div>
              <h3 class="project-title">{c.title}</h3>
              <p class="project-text">{c.text}</p>
              <div class="case-tags">
                {c.tags.map((t) => <span class="badge">{t}</span>)}
              </div>
              <span class="project-link">Подробнее <span aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ⑤ ПРОЦЕСС РАБОТЫ ───────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Как работаем</div>
        <h2>От задачи до готового изделия</h2>
      </div>
      <div class="steps">
        {steps.map((s) => (
          <div class="step">
            <div class="step-num">{s.num}</div>
            <h3 class="step-title">{s.title}</h3>
            <p class="step-text">{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ⑥ МАТЕРИАЛЫ ────────────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Материалы</div>
        <h2>С чем работаем</h2>
      </div>
      <div class="chips">
        {materials.map((m) => <span class="badge">{m}</span>)}
      </div>
      <p class="muted materials-note">Самые ходовые позиции — в запасе; чего нет, закажем у партнёров.</p>
    </div>
  </section>

  <!-- ⑦ CTA ──────────────────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="card card-featured cta-block">
        <h2>Есть чертёж или идея?</h2>
        <p class="lead">Пришлите — рассчитаем стоимость и сроки, подскажем по материалу и технологии.</p>
        <div class="cta-actions">
          <a href={tgHref()} class="btn btn-primary btn-lg" target="_blank" rel="noopener">Telegram</a>
          {contacts.maxHref && <a href={contacts.maxHref} class="btn btn-secondary btn-lg" target="_blank" rel="noopener">MAX</a>}
          <a href={contacts.phoneHref} class="btn btn-secondary btn-lg">{contacts.phone}</a>
          <a href={contacts.emailHref} class="btn btn-ghost btn-lg">{contacts.email}</a>
        </div>
      </div>
    </div>
  </section>

</Base>

<style>
  /* ─── HERO ─────────────────────────────────────────────────────────────── */
  .hero { padding-block: var(--space-8) var(--space-12); }
  @media (min-width: 900px) { .hero { padding-block: var(--space-16) var(--space-12); } }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero-inner { grid-template-columns: 1fr 420px; gap: var(--space-16); }
  }

  .hero-badge { margin-bottom: var(--space-6); }
  .hero-h1 { max-width: 16ch; font-size: clamp(2.1rem, 8.5vw, 4rem); line-height: 1.07; overflow-wrap: break-word; }
  .hero-lead { margin-top: var(--space-6); max-width: 56ch; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-8); }

  /* Подпись под кнопками: объясняет, зачем писать на почту (приложить чертёж),
     чтобы оранжевая кнопка с адресом читалась как действие, а не как контакт для справки. */
  .hero-mail { margin-top: var(--space-4); font-size: 15px; color: var(--text-secondary); }

  /* Фото героя показываем и на мобильном — иначе первый экран без единого изображения.
     На узких экранах ставим его ПЕРВЫМ (order), чтобы фото попадало в первый экран.
     Порядок в DOM не меняется — заголовок остаётся первым для поиска. */
  .hero-visual { display: block; order: -1; margin-bottom: var(--space-8); }
  @media (min-width: 900px) { .hero-visual { order: 0; margin-bottom: 0; } }
  .hero-visual img {
    width: 100%;
    aspect-ratio: 16 / 9; /* на мобильном ниже, чтобы в первый экран влезли и фото, и заголовок */
    object-fit: cover;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
  }
  @media (min-width: 900px) { .hero-visual img { aspect-ratio: 4 / 3; } }

  /* ─── КЛИЕНТЫ ──────────────────────────────────────────────────────────── */
  .clients-section { padding-block: var(--space-12); }

  .logos-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }
  @media (min-width: 640px)  { .logos-row { grid-template-columns: repeat(5, 1fr); gap: var(--space-4); } }
  @media (min-width: 1024px) { .logos-row { grid-template-columns: repeat(9, 1fr); } }

  /* Светлая плашка под логотипом. У 6 из 9 логотипов белая подложка ВПЕЧЕНА в файл
     (JPG без прозрачности), поэтому на тёмном фоне читаемо показать их можно только
     на светлом: белая подложка сливается с плашкой, прозрачные PNG получают светлый фон. */
  .logo-item {
    display: flex; align-items: center; justify-content: center;
    background: #FFFFFF;
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    height: 58px;
    transition: transform var(--duration-base) var(--ease-default),
                box-shadow var(--duration-base) var(--ease-default);
  }
  .logo-item:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
  /* Единая высота логотипа = визуальный порядок, несмотря на разные исходники */
  .logo-item img {
    max-height: 26px; max-width: 100%;
    width: auto; height: auto;
    object-fit: contain;
  }
  @media (min-width: 640px)  { .logo-item { height: 64px; } .logo-item img { max-height: 30px; } }
  @media (min-width: 1024px) { .logo-item { height: 72px; } .logo-item img { max-height: 34px; } }

  /* ─── НАПРАВЛЕНИЯ ──────────────────────────────────────────────────────── */
  .dir-card { padding: 0; overflow: hidden; }

  .dir-photo {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .dir-photo img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }
  .dir-card:hover .dir-photo img { transform: scale(1.05); }

  .dir-body { padding: var(--space-6); }
  @media (min-width: 768px) { .dir-body { padding: var(--space-6); } }

  .dir-title { margin-block: var(--space-3) var(--space-2); }

  .hub-row { margin-top: var(--space-8); }
  .hub-link {
    font-size: 14px; font-weight: 500; color: var(--text-tertiary);
    transition: color var(--duration-fast);
  }
  .hub-link:hover { color: var(--accent-primary); }

  /* ─── ПРИМЕРЫ РАБОТ ────────────────────────────────────────────────────── */
  .cases { display: flex; flex-direction: column; gap: var(--space-16); }

  .case {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
  }
  @media (min-width: 768px) {
    .case         { grid-template-columns: 1fr 1fr; gap: var(--space-12); }
    .case-flip .case-photo { order: 2; }
    .case-flip .case-body  { order: 1; }
  }

  .case-photo img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
  }

  .case-body { display: flex; flex-direction: column; gap: var(--space-4); }
  .case-body .eyebrow { margin-bottom: 0; }
  .case-title { font-size: 24px; line-height: 32px; margin: 0; }
  .case-text { color: var(--text-secondary); }
  .case-tags { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .case-link {
    display: inline-flex; align-items: center; gap: var(--space-1);
    font-size: 14px; font-weight: 500; color: var(--text-tertiary);
    margin-top: var(--space-2);
    transition: color var(--duration-fast);
  }
  .case-link:hover { color: var(--accent-primary); }

  /* ─── ПРОЕКТЫ (сетка карточек) ─────────────────────────────────────────── */
  .projects { margin-top: var(--space-4); }
  .project-card { padding: 0; overflow: hidden; display: flex; flex-direction: column; }
  .project-photo { aspect-ratio: 16 / 10; overflow: hidden; }
  .project-photo img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }
  .project-card:hover .project-photo img { transform: scale(1.05); }
  .project-body { padding: var(--space-6); display: flex; flex-direction: column; gap: var(--space-3); flex: 1; }
  .project-body .eyebrow { margin-bottom: 0; }
  .project-title { font-size: 19px; line-height: 1.3; margin: 0; }
  .project-text {
    color: var(--text-secondary); font-size: 14px; line-height: 1.55; margin: 0;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .project-body .case-tags { margin-top: auto; padding-top: var(--space-1); }
  .project-link {
    display: inline-flex; align-items: center; gap: var(--space-1);
    font-size: 14px; font-weight: 500; color: var(--text-tertiary);
    transition: color var(--duration-fast);
  }
  .project-card:hover .project-link { color: var(--accent-primary); }

  /* ─── ПРОЦЕСС РАБОТЫ ───────────────────────────────────────────────────── */
  .steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 640px)  { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .steps { grid-template-columns: repeat(4, 1fr); } }

  .step {
    padding: var(--space-6);
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
  }
  .step-num {
    font-family: var(--font-display);
    font-size: 40px; font-weight: 800; line-height: 1;
    color: var(--accent-primary);
    margin-bottom: var(--space-4);
  }
  .step-title { font-size: 17px; font-weight: 600; margin-bottom: var(--space-2); }
  .step-text  { font-size: 14px; color: var(--text-secondary); line-height: 22px; }

  /* ─── МАТЕРИАЛЫ ────────────────────────────────────────────────────────── */
  .materials-note { margin-top: var(--space-4); font-size: 14px; }

  /* ─── CTA ──────────────────────────────────────────────────────────────── */
  .cta-block h2 { margin-bottom: var(--space-3); }
  .cta-block .lead { margin-top: var(--space-2); max-width: 60ch; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }
</style>
