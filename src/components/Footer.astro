---
import { site } from '../data/site.js';
const { contacts, delivery, nav } = site;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="brand">{site.name}</div>
      <p class="muted">{site.tagline}</p>
      <p class="muted footer-materials">Фрезеруем любые материалы, кроме железа. Железо — лазером.</p>
    </div>

    <div class="footer-col">
      <div class="eyebrow">Контакты</div>
      <a href={contacts.phoneHref} class="footer-phone">{contacts.phone}</a>
      <a href={contacts.emailHref} class="footer-link">{contacts.email}</a>
      <p class="muted footer-address">{contacts.address}</p>
      <p class="muted footer-metro">м. {contacts.metro.join(' · ')}</p>
    </div>

    <div class="footer-col">
      <div class="eyebrow">Каналы</div>
      {contacts.socials.map((s) => (
        <a href={s.href} class="footer-link" target="_blank" rel="noopener">{s.label} — {s.handle}</a>
      ))}
    </div>

    <div class="footer-col">
      <div class="eyebrow">Разделы</div>
      {nav.map((item) => (
        <a href={item.href} class="footer-link">{item.label}</a>
      ))}
    </div>
  </div>

  <div class="container footer-bottom">
    <p class="muted">© {year} {site.domain}. Доставка: {delivery.join(', ')}.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-secondary);
    padding-block: var(--space-16) var(--space-8);
    margin-top: var(--space-24);
  }
  .footer-grid {
    display: grid; gap: var(--space-10);
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .footer-grid { grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: var(--space-8); }
  }
  .brand {
    font-family: var(--font-display); font-weight: 900; font-size: 22px;
    color: var(--text-primary); margin-bottom: var(--space-3);
  }
  .footer-materials { margin-top: var(--space-3); font-size: 14px; }
  .footer-col { display: flex; flex-direction: column; gap: var(--space-2); }
  .footer-col .eyebrow { margin-bottom: var(--space-2); }
  .footer-link {
    font-size: 14px; color: var(--text-secondary);
    transition: color var(--duration-fast) var(--ease-default);
  }
  .footer-link:hover { color: var(--accent-primary); }
  .footer-phone {
    font-size: 18px; font-weight: 600; color: var(--text-primary);
    transition: color var(--duration-fast);
  }
  .footer-phone:hover { color: var(--accent-primary); }
  .footer-address, .footer-metro { font-size: 14px; margin-top: var(--space-1); }
  .footer-bottom {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
  }
  .footer-bottom .muted { font-size: 13px; }
</style>
