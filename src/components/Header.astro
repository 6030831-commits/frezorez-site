---
import { site, slashed, tgHref } from '../data/site.js';
const { contacts, nav } = site;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="На главную">{site.name}</a>

    <nav class="nav" aria-label="Основная навигация">
      {nav.map((item) => (
        <div class="nav-item">
          <a href={slashed(item.href)} class="nav-link">{item.label}</a>
          {item.children && (
            <div class="nav-dropdown">
              {item.children.map((child) => (
                <a href={slashed(child.href)} class="nav-dropdown-link">{child.label}</a>
              ))}
            </div>
          )}
        </div>
      ))}
    </nav>

    <div class="header-actions">
      <a href={contacts.phoneHref} class="btn btn-primary header-cta">{contacts.phone}</a>
      <a
        href={contacts.emailHref}
        class="btn btn-primary header-mail"
        title={contacts.email}
        aria-label={`Написать на почту ${contacts.email}`}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="2" />
          <path d="m2 7 10 6 10-6" />
        </svg>
      </a>
    </div>

    <button class="nav-toggle" aria-label="Меню" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<!-- Мобильное меню (ВНЕ <header>: backdrop-filter шапки ломает position:fixed у детей) -->
<div class="mobile-menu" id="mobile-menu">
    <nav class="mobile-nav" aria-label="Мобильная навигация">
      {nav.map((item) => (
        <div class="m-group">
          <a href={slashed(item.href)} class="m-link">{item.label}</a>
          {item.children && (
            <div class="m-children">
              {item.children.map((child) => (
                <a href={slashed(child.href)} class="m-child">{child.label}</a>
              ))}
            </div>
          )}
        </div>
      ))}
    </nav>
    <div class="mobile-cta">
      <a href={tgHref()} class="btn btn-primary btn-lg" target="_blank" rel="noopener">Написать в Telegram</a>
      {contacts.maxHref && <a href={contacts.maxHref} class="btn btn-secondary btn-lg" target="_blank" rel="noopener">Написать в MAX</a>}
      <a href={contacts.phoneHref} class="btn btn-secondary btn-lg">{contacts.phone}</a>
      <a href={contacts.emailHref} class="btn btn-secondary btn-lg">{contacts.email}</a>
    </div>
  </div>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    height: 64px;
    background: rgba(10, 10, 11, 0.8);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-subtle);
  }
  .header-inner {
    height: 100%;
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-4);
  }
  .brand {
    font-family: var(--font-display); font-weight: 900; font-size: 22px;
    letter-spacing: 0.02em; color: var(--text-primary);
  }

  /* --- Десктоп-навигация --- */
  .nav { display: none; gap: var(--space-5); align-items: center; }
  .nav-item { position: relative; }
  .nav-link {
    font-size: 14px; font-weight: 500; color: var(--text-secondary);
    padding-block: 8px; white-space: nowrap;
    transition: color var(--duration-fast) var(--ease-default);
  }
  .nav-link:hover { color: var(--text-primary); }
  .nav-dropdown {
    position: absolute; top: 100%; left: 0;
    min-width: 240px;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-2);
    display: none; flex-direction: column;
    box-shadow: var(--shadow-lg);
  }
  .nav-item:hover .nav-dropdown { display: flex; }
  .nav-dropdown-link {
    font-size: 14px; color: var(--text-secondary);
    padding: 8px 12px; border-radius: var(--radius-sm);
    transition: background var(--duration-fast), color var(--duration-fast);
  }
  .nav-dropdown-link:hover { background: var(--bg-tertiary); color: var(--text-primary); }

  /* --- Кнопки в правом верхнем углу --- */
  /* Почта — квадратная иконка без подписи: меню при 1200 px занимает почти весь
     контейнер, и на текстовую подпись места нет (проверено замером — было бы
     перекрытие пункта «Контакты»). Адрес отдаётся через title и aria-label. */
  /* margin-left:auto прижимает кнопки вправо: на мобильном меню скрыто, и без этого
     space-between развешивал конверт по центру шапки, а не рядом с бургером.
     На десктопе видимой разницы нет — там свободного места и так почти не остаётся. */
  .header-actions {
    display: flex; align-items: center; gap: var(--space-2);
    flex-shrink: 0; margin-left: auto;
  }
  .header-cta, .header-mail { white-space: nowrap; }
  .header-mail { padding: 10px; }
  .header-mail svg { width: 18px; height: 18px; flex-shrink: 0; }

  /* --- Бургер --- */
  .nav-toggle {
    display: inline-flex; flex-direction: column; justify-content: center;
    gap: 5px; width: 44px; height: 44px; padding: 10px;
    border: 0; background: transparent; cursor: pointer; margin-right: -10px;
  }
  .nav-toggle span {
    display: block; height: 2px; width: 24px; border-radius: 2px;
    background: var(--text-primary);
    transition: transform var(--duration-base) var(--ease-default), opacity var(--duration-fast);
  }
  .nav-toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* --- Мобильное меню (оверлей под шапкой) --- */
  .mobile-menu {
    position: fixed; inset: 64px 0 0 0;
    background: var(--bg-primary);
    padding: var(--space-6) var(--pad-mobile) var(--space-12);
    overflow-y: auto;
    display: flex; flex-direction: column;
    transform: translateX(100%); visibility: hidden;
    transition: transform var(--duration-base) var(--ease-default), visibility var(--duration-base);
    z-index: 40;
  }
  .mobile-menu.open { transform: translateX(0); visibility: visible; }
  .m-group { border-bottom: 1px solid var(--border-subtle); padding: var(--space-2) 0; }
  .m-link {
    display: block; font-weight: 600;
    font-size: 17px; color: var(--text-primary); padding: var(--space-2) 0;
    letter-spacing: 0;
  }
  .m-children { display: flex; flex-direction: column; padding: 0 0 var(--space-2); }
  .m-child { font-size: 15px; font-weight: 400; color: var(--text-secondary); padding: 9px 0 9px var(--space-4); }
  .m-child:hover, .m-child:active { color: var(--accent-primary); }
  .mobile-cta { display: flex; flex-direction: column; gap: var(--space-3); margin-top: var(--space-8); }

  /* --- Брейкпойнты --- */
  @media (max-width: 639px) { .header-cta { display: none; } }
  @media (min-width: 640px) and (max-width: 1199px) {
    .header-cta { padding: 10px 16px; font-size: 13px; }
  }
  /* На десктопе логотип, меню и кнопки делят 1104 px контейнера. До этой правки шапка
     переполнялась на 17 px даже с одной кнопкой телефона, поэтому меню ужато: шрифт
     13 px вместо 14 и зазор 12 px вместо 20 — это высвобождает ~145 px.
     min-width у меню НЕ обнулять: значение auto не даёт ему сжаться уже содержимого,
     иначе пункты вылезают из своего блока и кнопка телефона наезжает на «Контакты». */
  @media (min-width: 1200px) {
    .nav { display: flex; gap: 12px; }
    .nav-link { font-size: 13px; }
    .header-cta { padding: 10px 16px; font-size: 13px; }
    .nav-toggle, .mobile-menu { display: none; }
  }
</style>

<script is:inline>
  (function () {
    var btn = document.querySelector('.nav-toggle');
    var menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    function set(open) {
      menu.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.setAttribute('aria-label', open ? 'Закрыть меню' : 'Меню');
      document.body.style.overflow = open ? 'hidden' : '';
    }
    btn.addEventListener('click', function () {
      set(!menu.classList.contains('open'));
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') set(false);
    });
  })();
</script>
